erDiagram
    DEPARTMENT {
      string id PK
      string name
    }

    UNIT {
      string id PK
      string dept_id FK
      string name
      string budget_code
    }

    USER {
      string id PK
      string username UK
      string email UK
      string password
      string full_name
      boolean is_active
      boolean daily_email
      datetime created_at
      datetime last_login_at
    }

    USER_ORGANIZATION_ROLE {
      string id PK
      string user_id FK
      string dept_id FK
      string unit_id FK
      enum role
    }

    USER_DELEGATION {
      string id PK
      string delegator_id FK
      string delegatee_id FK
      enum role
      string unit_id
      datetime start_date
      datetime end_date
      boolean is_active
      string created_by FK
      datetime cancelled_at
      string cancelled_by FK
    }

    REGISTRATION_REQUEST {
      string id PK
      string username
      string email
      string full_name
      string dept_id FK
      enum status
      string reviewed_by
      datetime reviewed_at
      datetime created_at
    }

    SAML_REQUEST_CACHE {
      string key PK
      string value
      datetime expires_at
      datetime created_at
    }

    SAML_RESPONSE_REPLAY {
      string response_hash PK
      datetime expires_at
      datetime created_at
    }

    PROJECT {
      string id PK
      string receive_no
      string title
      string description
      decimal budget
      decimal actual_cost
      enum status
      enum procurement_type
      enum current_workflow_type
      string requesting_dept_id FK
      string requesting_unit_id FK
      string responsible_unit_id FK
      string procurement_unit_id FK
      string contract_unit_id FK
      enum is_urgent
      int installment_rounds
      string pr_no
      string po_no
      string less_no
      string contract_no_id FK
      string vendor_name
      string vendor_email
      string created_by FK
      datetime created_at
    }

    PROJECT_CONTRACT_NUMBER {
      string id PK
      string type
      string contract_no UK
      boolean is_active
      string cancellation_reason
      datetime created_at
    }

    PROJECT_INSTALLMENT {
      string id PK
      string project_id FK
      int installment_no
      enum status
      string request_edit_reason
      string created_by FK
      datetime created_at
      string exported_by FK
      datetime exported_at
    }

    PROJECT_SUBMISSION {
      string id PK
      string project_id FK
      enum workflow_type
      int step_order
      enum submission_type
      int submission_round
      int installment_no
      enum status
      string submitted_by FK
      datetime submitted_at
      string approved_by FK
      datetime approved_at
      string proposing_by FK
      datetime proposing_at
      string completed_by FK
      datetime completed_at
      string comment
    }

    PROJECT_DOCUMENT {
      string id PK
      string submission_id FK
      string field_key
      string file_name
      string file_path
    }

    PROJECT_CANCELLATION {
      string id PK
      string project_id FK
      string reason
      enum status
      string requested_by FK
      datetime requested_at
      string decision_by FK
      datetime decision_at
    }

    PROJECT_HISTORY {
      string id PK
      string project_id FK
      enum action
      json old_value
      json new_value
      string comment
      string changed_by
      datetime changed_at
    }

    AUDIT_EVENT {
      string id PK
      enum kind
      enum event_type
      enum target_type
      string target_id
      string project_id FK
      string actor_id FK
      json actor_snapshot
      json target_snapshot
      json diff
      string comment
      datetime occurred_at
    }

    NOTIFICATION {
      string id PK
      string user_id FK
      string project_id FK
      string actor_id
      enum category
      enum priority
      string title
      string body
      boolean is_read
      datetime created_at
    }

    NOTIFICATION_DELIVERY {
      string id PK
      string notification_id FK
      string user_id FK
      enum channel
      enum status
      string subject
      string error_message
      datetime sent_at
    }

    NOTIFICATION_OUTBOX {
      string id PK
      string notification_id FK
      string user_id FK
      string event_type
      enum status
      int attempts
      datetime published_at
    }

    BUDGET_PLAN {
      string id PK
      int budget_year
      string unit_id FK
      int activity_type
      string activity_type_name
      decimal budget_amount
      string project_id FK
      string created_by
      datetime created_at
    }

    HOLIDAY {
      string id PK
      date date UK
      string name
    }

    DEPARTMENT ||--o{ UNIT : contains
    DEPARTMENT ||--o{ USER_ORGANIZATION_ROLE : scopes
    UNIT ||--o{ USER_ORGANIZATION_ROLE : scopes
    USER ||--o{ USER_ORGANIZATION_ROLE : holds
    DEPARTMENT ||--o{ REGISTRATION_REQUEST : references

    USER ||--o{ USER_DELEGATION : delegator
    USER ||--o{ USER_DELEGATION : delegatee

    USER ||--o{ PROJECT : creates
    DEPARTMENT ||--o{ PROJECT : requesting_department
    UNIT ||--o{ PROJECT : requesting_unit
    UNIT ||--o{ PROJECT : responsible_unit
    UNIT ||--o{ PROJECT : procurement_unit
    UNIT ||--o{ PROJECT : contract_unit

    PROJECT ||--o| PROJECT_CONTRACT_NUMBER : assigns
    PROJECT ||--o{ PROJECT_INSTALLMENT : contains
    PROJECT ||--o{ PROJECT_SUBMISSION : contains
    PROJECT_SUBMISSION ||--o{ PROJECT_DOCUMENT : contains
    PROJECT ||--o{ PROJECT_CANCELLATION : has
    PROJECT ||--o{ PROJECT_HISTORY : tracks
    PROJECT ||--o{ AUDIT_EVENT : audits
    PROJECT ||--o{ NOTIFICATION : triggers
    PROJECT ||--o{ BUDGET_PLAN : allocates
    UNIT ||--o{ BUDGET_PLAN : owns

    USER ||--o{ NOTIFICATION : receives
    NOTIFICATION ||--o{ NOTIFICATION_DELIVERY : delivers
    NOTIFICATION ||--o{ NOTIFICATION_OUTBOX : queues